#!/bin/bash
# Project verification gate: lint, unit/component tests, typecheck + production build.
# Exit non-zero on ANY failure. On success the .claude/verify-ok marker is
# refreshed — the require-verify hook blocks `git commit` / `gh pr create`
# whenever a source file is newer than that marker.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MARKER="$ROOT/.claude/verify-ok"
rm -f "$MARKER"
cd "$ROOT"

echo "verify: lint"
npm run lint
echo "verify: test"
npm test
echo "verify: build (tsc -b + vite build + prerender)"
npm run build

echo "verify: prerendered dist"
grep -q 'Get measurably stronger' dist/index.html || { echo "dist/index.html is missing the prerendered landing h1"; exit 1; }
grep -q '"@type": "FAQPage"' dist/index.html || { echo "dist/index.html is missing the FAQPage JSON-LD"; exit 1; }
for f in robots.txt sitemap.xml llms.txt; do test -s "dist/$f" || { echo "dist/$f is missing"; exit 1; }; done

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"
echo "verify: all stages passed"
